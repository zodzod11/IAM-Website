@import "tailwindcss";

/* ── Brand Tokens ────────────────────────────────────────────
 * These are placeholder values until we finalize the IAM brand
 * color system. All colors can be changed from this single file.
 * ────────────────────────────────────────────────────────── */

:root {
  --surface: #ffffff;
  --surface-alt: #f5f5f0;
  --base: #0f0f0f;
  --base-alt: #1a1a1a;
  --text-primary: #1a1a1a;
  --text-on-base: #cccccc;
  --text-muted: #6b6b6b;
  --accent: #c8963e;        /* 🔶 TBD — proposed amber/gold */
  --accent-hover: #d4a85c;  /* 🔶 TBD */
  --border: #e5e5e5;
  --border-dark: #2a2a2a;
}

@theme inline {
  --color-surface: var(--surface);
  --color-surface-alt: var(--surface-alt);
  --color-base: var(--base);
  --color-base-alt: var(--base-alt);
  --color-accent: var(--accent);
  --color-accent-hover: var(--accent-hover);
  --color-text-primary: var(--text-primary);
  --color-text-on-base: var(--text-on-base);
  --color-text-muted: var(--text-muted);
  --color-border: var(--border);
  --color-border-dark: var(--border-dark);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

/* ── Dark Mode ─────────────────────────────────────────────── */

@media (prefers-color-scheme: dark) {
  :root {
    --surface: #1a1a1a;
    --surface-alt: #222222;
    --text-primary: #e0e0e0;
    --text-muted: #888888;
    --border: #2a2a2a;
  }
}

/* ── Base Body Styles ──────────────────────────────────────── */

body {
  background: var(--base);
  color: var(--text-primary);
  font-family: var(--font-sans);
}

/* ── Utility: Force light mode sections ────────────────────── */
/* Used for cards, content sections on dark backgrounds.       */

.surface-card {
  background: var(--surface);
  color: var(--text-primary);
  border-color: var(--border);
}

/* ── Smooth scrolling ──────────────────────────────────────── */

html {
  scroll-behavior: smooth;
}

/* ── Reduced motion ────────────────────────────────────────── */

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  *, *::before, *::after {
    transition-duration: 0s !important;
    animation-duration: 0s !important;
  }
}
